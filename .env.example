# ==========================================
# MyIntroduce — 环境变量模板
# 复制此文件为 .env 并填入你的真实 Key
# ==========================================

# DashScope API Key (阿里云灵积) — 必填
# 获取/重置: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# LLM 模型选择: qwen-turbo / qwen-plus / qwen-max
LLM_MODEL_NAME=qwen-plus
FAST_LLM_MODEL_NAME=qwen-turbo

# Embedding 模型 (DashScope API，无需本地模型)
EMBEDDING_MODEL=text-embedding-v3

# Milvus Lite 向量数据库路径与集合名
MILVUS_DB_PATH=./milvus_data/my_intro_kb.db
MILVUS_COLLECTION_NAME=my_intro_knowledge

# 个人介绍对象的名字（用于系统提示与页面标题）
YOUR_NAME=你的名字

# 管理员密钥（入口填写此项进入管理员后台，默认 SKUNK）
ADMIN_CODE=SKUNK
